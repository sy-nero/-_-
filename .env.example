# ============================================================
#  הגדרות סביבה לבוט האיגוד — העתק לקובץ .env ומלא ערכים
# ============================================================

# --- Google Places API ---
# מפתח מ-Google Cloud Console עם Places API מופעל + חיוב
GOOGLE_MAPS_API_KEY=your-google-places-api-key
# מצב API: auto (בוחר לבד) / new (Places API New) / legacy (ה-API הישן)
PLACES_API_MODE=auto
# כמה עמודים למשוך לכל סוג עסק (legacy בלבד; כל עמוד = עד 20 תוצאות, מקס' 3)
MAX_PAGES_PER_TYPE=1

# --- סינון עסקים ---
# מספר ביקורות מקסימלי כדי להיחשב "עסק חדש" (0 = רק בלי ביקורות בכלל)
MAX_REVIEW_COUNT=0
# רדיוס חיפוש במטרים סביב כל שכונה
SEARCH_RADIUS_METERS=700
# האם לדרוש שהעסק יהיה פעיל (OPERATIONAL)
REQUIRE_OPERATIONAL=true

# --- שליחת מייל (SMTP של האיגוד) ---
SMTP_HOST=mail.example.co.il
SMTP_PORT=587
SMTP_USER=info@example.co.il
SMTP_PASSWORD=your-smtp-password
# true עבור פורט 465 (SSL), false עבור 587 (STARTTLS)
SMTP_USE_SSL=false
FROM_EMAIL=info@example.co.il
FROM_NAME=איגוד העסקים
REPLY_TO=info@example.co.il

# --- תוכן המייל ---
ASSOCIATION_NAME=איגוד העסקים החרדיים
LANDING_PAGE_URL=https://example.co.il/register
UNSUBSCRIBE_URL=https://example.co.il/unsubscribe
# נתיב ללוגו האיגוד (PNG/JPG) שיוטמע במייל. שימו את הקובץ ב-assets/logo.png
LOGO_PATH=assets/logo_white.png

# יעד: כמה מיילים לאסוף בסריקה לפני עצירה
TARGET_EMAILS=50

# --- בטיחות / קצב ---
# מספר מיילים מקסימלי לשליחה בהרצה אחת (הגנה מפני חסימת ספאם)
MAX_EMAILS_PER_RUN=50
# הערה: MAX_REVIEW_COUNT=0 מגביל לעסקים חדשים לגמרי (בלי אתר לרוב).
# להגדלת סיכוי למצוא 50 מיילים — אפשר להעלות ל-3 עד 5.
# השהיה בשניות בין בקשות רשת
REQUEST_DELAY_SECONDS=1.0

# --- דף הנחיתה (Flask) ---
FLASK_SECRET_KEY=change-me-to-random-string
LANDING_PORT=5000

SENDER_NAME=יוסף חיים וייס
SENDER_TITLE=מנהל קשרי לקוחות

# חיפוש אתרי חברות בקמפיין מ״א (Google Custom Search):
GOOGLE_SEARCH_KEY=
GOOGLE_SEARCH_CX=

# --- קמפיין מענק מחשוב 4.56 (grant): שולח מהמייל האישי של מירי ---
# הבוט ישלח את קמפיין ה-grant מהכתובת הזאת (Gmail + סיסמת אפליקציה)
GRANT_FROM_EMAIL=
GRANT_FROM_NAME=מירי בר לב
GRANT_SMTP_USER=
# סיסמת אפליקציה של Gmail (אפשר עם רווחים, הם מוסרים אוטומטית)
GRANT_SMTP_PASSWORD=

# --- קמפיין גיוס סוכנים ממליצים (agent): נשלח אישית בשם מירי מסינרו ---
# ראו docs/agents.md. אם ה-SMTP של האיגוד לא מורשה לשלוח מהכתובת הזאת,
# מלאו כאן משתמש/סיסמה של תיבת סינרו (אחרת נופל ל-SMTP_USER/SMTP_PASSWORD).
AGENT_FROM_EMAIL=cto@sy-nero.com
AGENT_FROM_NAME=מירי לודמיר
AGENT_SENDER_TITLE=מנהלת סינרו טק
AGENT_COMPANY=סינרו טק
# טלפון בחתימה (ריק = בלי טלפון, רק מייל)
AGENT_SENDER_PHONE=
# קישור לאתר שמופיע בחתימת המייל
AGENT_WEBSITE=https://tech.sy-nero.com/
AGENT_SMTP_USER=
AGENT_SMTP_PASSWORD=
# אילו בעלי מקצוע לסרוק (סוגי Google, מופרדים בפסיק). ריק = רו"ח, עו"ד, ביטוח, תיווך
AGENT_TYPES=
# תנאי סף לסוכן: לפחות כמה ביקורות, ובאיזה דירוג מינימלי ("ביקורות חיוביות")
AGENT_MIN_REVIEWS=2
AGENT_MIN_RATING=4.0

