# ============================================================
#  הגדרות סביבה לבוט האיגוד — העתק לקובץ .env ומלא ערכים
# ============================================================

# --- Google Places API ---
# מפתח מ-Google Cloud Console עם Places API מופעל + חיוב
GOOGLE_MAPS_API_KEY=your-google-places-api-key
# מצב API: auto (בוחר לבד) / new (Places API New) / legacy (ה-API הישן)
PLACES_API_MODE=auto
# כמה עמודים למשוך לכל סוג עסק (legacy בלבד; כל עמוד = עד 20 תוצאות, מקס' 3)
MAX_PAGES_PER_TYPE=1

# --- סינון עסקים ---
# מספר ביקורות מקסימלי כדי להיחשב "עסק חדש" (0 = רק בלי ביקורות בכלל)
MAX_REVIEW_COUNT=0
# רדיוס חיפוש במטרים סביב כל שכונה
SEARCH_RADIUS_METERS=700
# האם לדרוש שהעסק יהיה פעיל (OPERATIONAL)
REQUIRE_OPERATIONAL=true

# --- שליחת מייל (SMTP של האיגוד) ---
SMTP_HOST=mail.example.co.il
SMTP_PORT=587
SMTP_USER=info@example.co.il
SMTP_PASSWORD=your-smtp-password
# true עבור פורט 465 (SSL), false עבור 587 (STARTTLS)
SMTP_USE_SSL=false
FROM_EMAIL=info@example.co.il
FROM_NAME=איגוד העסקים
REPLY_TO=info@example.co.il

# --- תוכן המייל ---
ASSOCIATION_NAME=איגוד העסקים החרדי
LANDING_PAGE_URL=https://example.co.il/register
UNSUBSCRIBE_URL=https://example.co.il/unsubscribe

# --- בטיחות / קצב ---
# מספר מיילים מקסימלי לשליחה בהרצה אחת (הגנה מפני חסימת ספאם)
MAX_EMAILS_PER_RUN=50
# השהיה בשניות בין בקשות רשת
REQUEST_DELAY_SECONDS=1.0

# --- דף הנחיתה (Flask) ---
FLASK_SECRET_KEY=change-me-to-random-string
LANDING_PORT=5000
